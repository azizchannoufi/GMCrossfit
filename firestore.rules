rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catalog — public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packs/{packId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public settings only (no Telegram secrets here)
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — created solely by Cloud Functions (Admin SDK bypasses rules)
    match /orders/{orderId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Analytics & rate limits — Functions only
    match /page_views/{docId} {
      allow read, write: if false;
    }

    match /product_clicks/{docId} {
      allow read, write: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
